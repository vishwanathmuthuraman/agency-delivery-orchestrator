{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign",
  "description": "Blueprint contract; not evidence of application behavior. See examples/README.md for fixture semantics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "budget_minor": {
      "type": "integer",
      "minimum": 0
    },
    "scope_version": {
      "type": "integer",
      "minimum": 1
    },
    "scope_approved": {
      "type": "boolean"
    },
    "cost_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "minor_per_hour": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "role",
          "version",
          "minor_per_hour"
        ]
      }
    },
    "source_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "fact_id",
          "version",
          "value",
          "source_ref"
        ]
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deliverable_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "caption",
              "video_edit_packet",
              "graphic_edit_packet"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "fact_version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "fact_id",
                "fact_version"
              ]
            }
          },
          "status": {
            "enum": [
              "draft",
              "in_review",
              "approved",
              "scheduled",
              "verified"
            ]
          },
          "destination": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "deliverable_id",
          "version",
          "kind",
          "content",
          "fact_refs",
          "status",
          "destination"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "deliverable_id": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "minLength": 1
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "rate_version": {
            "type": "integer",
            "minimum": 1
          },
          "estimated_cost_minor": {
            "type": "integer",
            "minimum": 0
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "ready",
              "blocked",
              "in_progress",
              "complete"
            ]
          }
        },
        "required": [
          "task_id",
          "deliverable_id",
          "owner_role",
          "estimated_minutes",
          "rate_version",
          "estimated_cost_minor",
          "depends_on",
          "status"
        ]
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "approval_id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "enum": [
              "scope",
              "content",
              "commercial",
              "dispatch"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_version": {
            "type": "integer",
            "minimum": 1
          },
          "fact_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "fact_version": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "fact_id",
                "fact_version"
              ]
            }
          },
          "approved_by_role": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "approval_id",
          "purpose",
          "subject_id",
          "subject_version",
          "fact_refs",
          "approved_by_role",
          "approved_at",
          "valid"
        ]
      }
    },
    "authority_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "allowed_event_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "brief_approved",
                "work_completed",
                "approval_granted",
                "client_change_received",
                "impact_reviewed",
                "commercial_decision_recorded",
                "source_revision_committed",
                "artifact_revision_prepared",
                "dispatch_requested",
                "connector_observed",
                "reconciliation_observed",
                "tenant_reference_requested",
                "acceptance_recorded",
                "closure_requested"
              ]
            }
          },
          "allowed_approval_purposes": {
            "type": "array",
            "items": {
              "enum": [
                "scope",
                "content",
                "commercial",
                "dispatch"
              ]
            }
          }
        },
        "required": [
          "role",
          "allowed_event_kinds",
          "allowed_approval_purposes"
        ]
      }
    }
  },
  "required": [
    "tenant_id",
    "campaign_id",
    "currency",
    "budget_minor",
    "scope_version",
    "scope_approved",
    "cost_rates",
    "source_facts",
    "deliverables",
    "tasks",
    "approvals",
    "authority_map"
  ]
}
