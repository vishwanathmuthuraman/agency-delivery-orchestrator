                "minimum": 0
              },
              "rate_version": {
                "type": "integer",
                "minimum": 1
              },
              "estimated_cost_minor": {
                "type": "integer",
                "minimum": 0
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
