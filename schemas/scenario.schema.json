              },
              "approved_by_role": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "valid": {
                "type": "boolean"
              }
            },
            "required": [
              "approval_id",
              "purpose",
              "subject_id",
              "subject_version",
              "fact_refs",
              "approved_by_role",
              "approved_at",
              "valid"
            ]
          }
