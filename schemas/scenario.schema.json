{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "description": "Blueprint contract; not evidence of application behavior. See examples/README.md for fixture semantics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "initial_campaign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "budget_minor": {
          "type": "integer",
          "minimum": 0
        },
        "scope_version": {
          "type": "integer",
          "minimum": 1
        },
        "scope_approved": {
          "type": "boolean"
        },
        "cost_rates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "minor_per_hour": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "role",
              "version",
              "minor_per_hour"
            ]
          }
        },
        "source_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "fact_id",
              "version",
              "value",
              "source_ref"
            ]
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "deliverable_id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "caption",
                  "video_edit_packet",
                  "graphic_edit_packet"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "fact_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "fact_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fact_version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "fact_id",
                    "fact_version"
                  ]
                }
              },
              "status": {
                "enum": [
                  "draft",
                  "in_review",
                  "approved",
                  "scheduled",
                  "verified"
                ]
              },
              "destination": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "deliverable_id",
              "version",
              "kind",
              "content",
              "fact_refs",
              "status",
              "destination"
            ]
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
