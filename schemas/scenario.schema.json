                    "commercial_decision_recorded",
                    "source_revision_committed",
                    "artifact_revision_prepared",
                    "dispatch_requested",
                    "connector_observed",
                    "reconciliation_observed",
                    "tenant_reference_requested",
                    "acceptance_recorded",
                    "closure_requested"
