# Proposed configuration only. There is no implemented application loader yet.
# The planned default demo requires no model provider, credentials or network.
ADO_MODE=offline
ADO_DATABASE_PATH=local-data/agency-delivery.sqlite3
ADO_NETWORK_ENABLED=false
ADO_CONNECTOR_MODE=mock
ADO_MODEL_ENABLED=false
ADO_MODEL_PROVIDER=
ADO_MODEL_NAME=
ADO_MODEL_API_KEY=
# Any future paid evaluation requires a separately agreed spending cap.
ADO_MODEL_MAX_REQUESTS=0
